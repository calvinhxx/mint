cmake_minimum_required(VERSION 3.24)

get_filename_component(test_directory_name "${MINT_TEST_DIRECTORY}" NAME)
if(NOT IS_ABSOLUTE "${MINT_TEST_DIRECTORY}" OR
   NOT test_directory_name STREQUAL "macos-development-app-contract" OR
   IS_SYMLINK "${MINT_TEST_DIRECTORY}")
    message(FATAL_ERROR "An isolated macos-development-app-contract directory is required")
endif()
file(REMOVE_RECURSE "${MINT_TEST_DIRECTORY}")
file(MAKE_DIRECTORY "${MINT_TEST_DIRECTORY}/fixture")
set(fixture_source "${MINT_TEST_DIRECTORY}/fixture")
set(fixture_build "${MINT_TEST_DIRECTORY}/build with spaces")
set(bundle "${fixture_build}/Mint.app")
file(WRITE "${fixture_source}/gui" "synthetic GUI v1\n")
file(WRITE "${fixture_source}/cli" "synthetic CLI v1\n")
file(WRITE "${fixture_source}/codesign" [=[#!/bin/sh
printf '%s\n' 'CALL' "$@" >> "$(dirname "$0")/codesign.log"
]=])
file(CHMOD "${fixture_source}/codesign" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
file(WRITE "${fixture_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(MintAppContract VERSION 2.3.4 LANGUAGES NONE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "13.0")
set(MINT_CODESIGN_EXECUTABLE "${CMAKE_CURRENT_SOURCE_DIR}/codesign")
add_executable(fixture_gui IMPORTED GLOBAL)
set_target_properties(fixture_gui PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/gui")
add_executable(fixture_cli IMPORTED GLOBAL)
set_target_properties(fixture_cli PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/cli")
include("${MINT_SOURCE_DIR}/cmake/MintMacOSDevelopmentApp.cmake")
mint_add_macos_development_app(fixture_gui fixture_cli)
]=])
execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${fixture_source}" -B "${fixture_build}"
        -G "${MINT_TEST_GENERATOR}" "-DMINT_SOURCE_DIR=${MINT_SOURCE_DIR}"
    RESULT_VARIABLE configured OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT configured STREQUAL "0")
    message(FATAL_ERROR "Cannot configure the app fixture: ${output}${error}")
endif()

function(build_app expected_success)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" --build "${fixture_build}" --target mint_gui_app
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    )
    if(expected_success AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot build the app fixture: ${output}${error}")
    elseif(NOT expected_success AND result STREQUAL "0")
        message(FATAL_ERROR "An unsafe app destination was accepted")
    endif()
endfunction()

function(expect_contents path expected)
    file(READ "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected fixture contents: ${path}")
    endif()
endfunction()

build_app(TRUE)
expect_contents("${bundle}/Contents/MacOS/mint-gui" "synthetic GUI v1\n")
expect_contents("${bundle}/Contents/MacOS/mint" "synthetic CLI v1\n")
file(READ "${bundle}/Contents/Info.plist" plist)
foreach(value "com.calvinhxx.mint.gui" "2.3.4" "13.0" "mint-gui")
    string(FIND "${plist}" "<string>${value}</string>" present)
    if(present EQUAL -1)
        message(FATAL_ERROR "Missing app metadata: ${value}")
    endif()
endforeach()

# EN: A second explicit target run must refresh the CLI without changing the GUI input.
# ZH-CN: 再次执行目标必须更新 CLI，同时保持 GUI 输入不变。
file(WRITE "${fixture_source}/cli" "synthetic CLI v2\n")
build_app(TRUE)
expect_contents("${bundle}/Contents/MacOS/mint" "synthetic CLI v2\n")
file(REMOVE_RECURSE "${bundle}")
build_app(TRUE)
expect_contents("${bundle}/Contents/MacOS/mint-gui" "synthetic GUI v1\n")
expect_contents("${bundle}/Contents/MacOS/mint" "synthetic CLI v2\n")
expect_contents("${fixture_source}/gui" "synthetic GUI v1\n")
expect_contents("${fixture_source}/cli" "synthetic CLI v2\n")
if(EXISTS "${bundle}/Contents/Frameworks")
    message(FATAL_ERROR "A local development app must not copy external Qt frameworks")
endif()

file(STRINGS "${fixture_source}/codesign.log" signing_arguments)
file(REAL_PATH "${fixture_build}" canonical_build)
set(signing_calls 0)
foreach(argument IN LISTS signing_arguments)
    if(argument STREQUAL "CALL")
        math(EXPR signing_calls "${signing_calls} + 1")
    elseif(argument STREQUAL "--deep")
        message(FATAL_ERROR "Recursive signing is not allowed")
    elseif(IS_ABSOLUTE "${argument}")
        set(staging_suffix "/\\.Mint-[0-9a-f]+\\.app(/Contents/MacOS/mint)?$")
        if(NOT argument MATCHES "${staging_suffix}")
            message(FATAL_ERROR "Signing must only address newly copied app contents: ${argument}")
        endif()
        string(REGEX REPLACE "${staging_suffix}" "" signing_parent "${argument}")
        file(REAL_PATH "${signing_parent}" canonical_signing_parent)
        if(NOT canonical_signing_parent STREQUAL canonical_build)
            message(FATAL_ERROR "Signing escaped the isolated build directory: ${argument}")
        endif()
    endif()
endforeach()
if(NOT signing_calls EQUAL 12)
    message(FATAL_ERROR "Each target invocation must sign and verify its own copied programs")
endif()
file(READ "${fixture_source}/codesign.log" signed_before_rejection)

# EN: Reject output aliases before copying or signing; preserve unrelated external contents.
# ZH-CN: 复制或签名前拒绝输出别名，保留无关外部目录内容。
file(MAKE_DIRECTORY "${MINT_TEST_DIRECTORY}/external")
file(WRITE "${MINT_TEST_DIRECTORY}/external/untouched" "external sentinel\n")
file(REMOVE_RECURSE "${bundle}")
file(CREATE_LINK "${MINT_TEST_DIRECTORY}/external" "${bundle}" SYMBOLIC)
build_app(FALSE)
expect_contents("${MINT_TEST_DIRECTORY}/external/untouched" "external sentinel\n")
expect_contents("${fixture_source}/codesign.log" "${signed_before_rejection}")
file(REMOVE "${bundle}")
file(MAKE_DIRECTORY "${bundle}/Contents")
file(CREATE_LINK "${MINT_TEST_DIRECTORY}/external" "${bundle}/Contents/MacOS" SYMBOLIC)
build_app(FALSE)
expect_contents("${MINT_TEST_DIRECTORY}/external/untouched" "external sentinel\n")
expect_contents("${fixture_source}/codesign.log" "${signed_before_rejection}")
file(REMOVE "${bundle}/Contents/MacOS")
file(REMOVE_RECURSE "${bundle}")
message(STATUS "Development app creation, refresh, recreation and signing boundaries passed")
