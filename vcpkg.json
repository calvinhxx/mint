{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mint",
  "version-string": "1.0.0",
  "description": "Lightweight general AI agent toolkit in C++",
  "license": "MIT",
  "builtin-baseline": "5cd4931b18d49c77074703cf293a7837ac7506fa",
  "dependencies": [
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    "nlohmann-json",
    "spdlog"
  ],
  "features": {
    "tests": {
      "description": "Build mint unit, integration, and contract tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
